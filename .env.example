# --- Database (pgvector) ---
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent_studio

# --- Models (via LiteLLM / ModelProvider seam) ---
# Any OpenAI-compatible provider works; BYOK per-tenant is resolved behind the seam.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Default model used by examples when no manifest override is given.
AGENT_STUDIO_DEFAULT_MODEL=gpt-4o-mini

# --- Runtime ---
# Set to 1 to force the deterministic EchoModelProvider (no network, for CI/demos).
AGENT_STUDIO_OFFLINE=0

# --- Tenancy ---
AGENT_STUDIO_DEFAULT_TENANT=default
